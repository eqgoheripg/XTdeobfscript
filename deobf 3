local __XT_CONFIG = __XT_CONFIG or {}          
local __XT_UI_ALIVE = true                     

local function get_aura(section)
    local t = __XT_CONFIG[section]
    if type(t) ~= "table" then
        t = {}
        __XT_CONFIG[section] = t
    end
    return t
end

local function set_aura(section, data, save)
    local t = get_aura(section)
    for k, v in pairs(data) do
        t[k] = v
    end
    if save ~= false then
        __XT_CONFIG.__dirty = os.clock()
    end
    return t
end

local function notify_allowed()
    return __XT_UI_ALIVE
end







